{
  "stryker-config": {
    "project": "Carubbi.AudioConverter.Api.csproj",
    "test-projects": [
      "Carubbi.AudioConverter.Api.Tests/Carubbi.AudioConverter.Api.Tests.csproj"
    ],
    "test-runner": "mtp",
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "mutate": [
      "**/*.cs",
      "!Program.cs",
      "!Controllers/**",
      "!Converters/WavToMp3Converter.cs",
      "!Converters/Mp3ToWavConverter.cs",
      "!Converters/WavToOggConverter.cs",
      "!Converters/OggToWavConverter.cs",
      "!Converters/Mp3ToOggConverter.cs",
      "!Converters/OggToMp3Converter.cs",
      "!Utilities/EnvironmentVariablesConfig.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    }
  }
}
